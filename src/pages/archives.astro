---
import PageLayout from '@layouts/PageLayout.astro';
import { getPublishedPosts, formatDate, groupByYear, postUrl } from '@utils/posts';
import { getLangFromUrl, useTranslations, localizedPath } from '@i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getPublishedPosts(lang);
const archive = groupByYear(posts);
---

<PageLayout title={t('nav.archives')} description="按年份归档">
  {archive.length === 0 ? (
    <p class="text-muted text-center py-12">还没有文章可归档。</p>
  ) : (
    archive.map(({ year, posts: yearPosts }) => (
      <section class="mb-8">
        <h2 class="font-serif text-2xl font-bold mb-4 text-brand-700 dark:text-brand-300 sticky top-24 glass-pill px-4 py-2 inline-block">
          {year} <span class="text-sm text-muted ml-2">({yearPosts.length})</span>
        </h2>
        <ul class="ml-2 border-l-2 border-brand-300/40 pl-6 space-y-3">
          {yearPosts.map((p) => (
            <li class="relative">
              <span class="absolute -left-[1.9rem] top-2 w-3 h-3 rounded-full bg-brand-500 ring-4 ring-brand-200/40"></span>
              <a
                href={postUrl(p)}
                class="flex items-baseline gap-3 hover:text-brand-600 dark:hover:text-brand-300 transition-colors"
              >
                <time class="text-xs text-muted whitespace-nowrap font-mono">
                  {formatDate(p.data.pubDate, lang).replace(/^\d{4}年/, '').replace(/^\d{4}-/, '')}
                </time>
                <span class="font-serif">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</PageLayout>
