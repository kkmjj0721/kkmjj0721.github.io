---
import type { GetStaticPaths } from 'astro';
import PageLayout from '@layouts/PageLayout.astro';
import PostCard from '@components/post/PostCard.astro';
import { getPublishedPosts, groupByTag } from '@utils/posts';
import { getLangFromUrl } from '@i18n/ui';

export const getStaticPaths = (async () => {
  const all = await getPublishedPosts();
  const grouped = groupByTag(all);
  return Object.entries(grouped).map(([tag, posts]) => ({
    params: { tag },
    props: { posts },
  }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const localized = posts.filter((p) => p.data.lang === lang);
---

<PageLayout title={`#${tag}`} description={`标签: ${tag}`}>
  <p class="text-muted mb-6">共 {localized.length} 篇文章</p>
  <div class="flex flex-col gap-5">
    {localized.map((p) => <PostCard post={p} />)}
  </div>
</PageLayout>
