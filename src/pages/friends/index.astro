---
import { getCollection } from "astro:content";
import EmptyState from "@components/collection/EmptyState.astro";
import PageLayout from "@layouts/PageLayout.astro";

const friends = (await getCollection("friends")).sort((a, b) => {
  const groupCompare = a.data.group.localeCompare(b.data.group, "zh-Hans-CN");
  if (groupCompare !== 0) return groupCompare;
  return a.data.name.localeCompare(b.data.name, "zh-Hans-CN");
});

const grouped = friends.reduce<Record<string, typeof friends>>(
  (acc, friend) => {
    (acc[friend.data.group] ??= []).push(friend);
    return acc;
  },
  {},
);
const groups = Object.entries(grouped);
const fallbackAvatar = "/images/placeholders/avatar.placeholder.svg";
---

<PageLayout title="友链" description="朋友们的站点与作品入口。">
  {
    groups.length === 0 ? (
      <EmptyState
        title="友链还没有内容"
        description="在 src/content/friends/ 下添加 YAML 数据文件后，这里会自动按分组展示头像、名称和简介。"
      />
    ) : (
      <div class="space-y-8">
        {groups.map(([group, list]) => (
          <section>
            <div class="mb-4 flex items-center justify-between gap-4">
              <h2 class="font-serif text-2xl font-semibold text-brand-700 dark:text-brand-300">
                {group}
              </h2>
              <span class="text-sm text-muted">{list.length} 个站点</span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {list.map((friend) => (
                <a
                  href={friend.data.url}
                  target="_blank"
                  rel="noreferrer"
                  class="glass glass-hover flex gap-4 p-5"
                >
                  <img
                    src={friend.data.avatar ?? fallbackAvatar}
                    alt={friend.data.name}
                    loading="lazy"
                    class="h-14 w-14 flex-shrink-0 rounded-full object-cover ring-2 ring-brand-200/50"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-serif text-lg font-semibold text-ink">
                      {friend.data.name}
                    </span>
                    {friend.data.description && (
                      <span class="mt-1 block text-sm leading-relaxed text-muted">
                        {friend.data.description}
                      </span>
                    )}
                    {friend.data.tags.length > 0 && (
                      <span class="mt-3 flex flex-wrap gap-2">
                        {friend.data.tags.slice(0, 4).map((tag) => (
                          <span class="rounded-full bg-brand-100/50 px-2 py-0.5 text-xs text-brand-700 dark:bg-brand-900/30 dark:text-brand-200">
                            #{tag}
                          </span>
                        ))}
                      </span>
                    )}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</PageLayout>
