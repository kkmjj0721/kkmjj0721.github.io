---
import { getCollection } from "astro:content";
import EmptyState from "@components/collection/EmptyState.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getLangFromUrl } from "@i18n/ui";
import { formatDate } from "@utils/posts";

const lang = getLangFromUrl(Astro.url);
const albums = (await getCollection("gallery")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const totalPhotos = albums.reduce(
  (sum, album) => sum + album.data.images.length,
  0,
);
const albumsWithContent = await Promise.all(
  albums.map(async (album) => {
    const { Content } = await album.render();
    return { album, Content };
  }),
);
---

<PageLayout title="照片墙" description="按时间整理的摄影、旅行与日常影像。">
  <div class="mb-8 grid gap-3 sm:grid-cols-3">
    <div class="glass-soft p-4">
      <p class="text-xs text-muted">相册</p>
      <p
        class="mt-1 font-mono text-2xl font-semibold text-brand-700 dark:text-brand-300"
      >
        {albums.length}
      </p>
    </div>
    <div class="glass-soft p-4">
      <p class="text-xs text-muted">照片</p>
      <p
        class="mt-1 font-mono text-2xl font-semibold text-brand-700 dark:text-brand-300"
      >
        {totalPhotos}
      </p>
    </div>
    <div class="glass-soft p-4">
      <p class="text-xs text-muted">最新更新</p>
      <p class="mt-1 text-sm font-semibold text-ink">
        {albums[0] ? formatDate(albums[0].data.date, lang) : "待整理"}
      </p>
    </div>
  </div>

  {
    albumsWithContent.length === 0 ? (
      <EmptyState
        title="相册还没有公开内容"
        description="在 src/content/gallery/ 下添加 Markdown 或 MDX 相册条目后，这里会自动生成时间轴和图片网格。"
      />
    ) : (
      <div class="space-y-8 border-l border-brand-300/35 pl-5 md:pl-8">
        {albumsWithContent.map(({ album, Content }) => (
          <article class="relative">
            <span class="absolute -left-[1.72rem] top-2 h-3 w-3 rounded-full bg-brand-500 ring-4 ring-brand-200/40 md:-left-[2.1rem]" />
            <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-muted">
              <time datetime={album.data.date.toISOString()}>
                {formatDate(album.data.date, lang)}
              </time>
              {album.data.location && <span>{album.data.location}</span>}
              <span>{album.data.category}</span>
            </div>

            <h2 class="font-serif text-2xl font-semibold text-ink">
              {album.data.title}
            </h2>
            {album.data.description && (
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {album.data.description}
              </p>
            )}

            {(album.data.camera || album.data.lens) && (
              <div class="mt-3 flex flex-wrap gap-2 text-xs text-muted">
                {album.data.camera && (
                  <span class="glass-pill px-3 py-1">{album.data.camera}</span>
                )}
                {album.data.lens && (
                  <span class="glass-pill px-3 py-1">{album.data.lens}</span>
                )}
              </div>
            )}

            <div class="prose prose-slate mt-4 max-w-none dark:prose-invert">
              <Content />
            </div>

            {album.data.images.length === 0 ? (
              <div class="mt-5 rounded-xl border border-dashed border-brand-300/40 p-6 text-center text-sm text-muted">
                这个相册还没有图片。
              </div>
            ) : (
              <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {album.data.images.map((image) => (
                  <figure class="group overflow-hidden rounded-xl bg-brand-100/30 dark:bg-white/5">
                    <a href={image.src} target="_blank" rel="noreferrer">
                      <img
                        src={image.src}
                        alt={image.alt ?? image.caption ?? album.data.title}
                        loading="lazy"
                        class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      />
                    </a>
                    {image.caption && (
                      <figcaption class="px-3 py-2 text-xs text-muted">
                        {image.caption}
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    )
  }
</PageLayout>
