---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizedPath } from '@i18n/ui';
import { formatDate, postUrl } from '@utils/posts';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = postUrl(post);
---

<article class="glass glass-hover p-5 md:p-6 flex flex-col md:flex-row gap-5">
  {post.data.cover && (
    <a href={href} class="block md:w-48 md:flex-shrink-0">
      {/* TODO(image): 自动渲染封面图，作者只需在 frontmatter 写 cover */}
      <img
        src={typeof post.data.cover === 'string' ? post.data.cover : post.data.cover.src}
        alt={post.data.coverAlt ?? post.data.title}
        class="rounded-lg w-full h-32 md:h-28 object-cover"
        loading="lazy"
      />
    </a>
  )}
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 text-xs text-muted mb-2 flex-wrap">
      <time datetime={post.data.pubDate.toISOString()}>
        📅 {formatDate(post.data.pubDate, lang)}
      </time>
      {post.data.sticky > 0 && (
        <span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-700 dark:text-amber-300">
          📌 {t('status.sticky')}
        </span>
      )}
      {post.data.draft && (
        <span class="px-2 py-0.5 rounded-full bg-gray-500/20 text-gray-700 dark:text-gray-300">
          {t('status.draft')}
        </span>
      )}
      {post.data.series && (
        <span class="px-2 py-0.5 rounded-full bg-brand-500/20 text-brand-700 dark:text-brand-300">
          📚 {post.data.series}
        </span>
      )}
    </div>
    <h2 class="font-serif text-xl md:text-2xl font-semibold mb-2 line-clamp-2">
      <a href={href} class="hover:text-brand-600 dark:hover:text-brand-300 transition-colors">
        {post.data.title}
      </a>
    </h2>
    {post.data.description && (
      <p class="text-muted text-sm leading-relaxed line-clamp-2 mb-3">
        {post.data.description}
      </p>
    )}
    <div class="flex items-center gap-2 text-xs flex-wrap">
      {post.data.categories.map((c) => (
        <a
          href={localizedPath(`/categories/${c}/`, lang)}
          class="px-2 py-0.5 rounded-full bg-brand-100/50 dark:bg-brand-900/30 hover:bg-brand-200/60 transition-colors"
        >
          📂 {c}
        </a>
      ))}
      {post.data.tags.slice(0, 4).map((tag) => (
        <a
          href={localizedPath(`/tags/${tag}/`, lang)}
          class="text-muted hover:text-brand-600 dark:hover:text-brand-300"
        >
          #{tag}
        </a>
      ))}
    </div>
  </div>
</article>
