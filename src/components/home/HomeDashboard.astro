---
import { Icon } from 'astro-icon/components';
import { site } from '@data/site';
import { getLangFromUrl, localizedPath, useTranslations } from '@i18n/ui';
import { formatDate, getPublishedPosts, postUrl } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getPublishedPosts(lang);
const latestPosts = posts.slice(0, 4);

const galleryCount = Object.keys(import.meta.glob('../../content/gallery/**/*.{md,mdx}')).length;
const projectCount = Object.keys(import.meta.glob('../../content/projects/**/*.{md,mdx}')).length;
const momentCount = Object.keys(import.meta.glob('../../content/moments/**/*.{md,mdx}')).length;
const animeCount = Object.keys(import.meta.glob('../../content/anime/**/*.{md,mdx}')).length;
const gameCount = Object.keys(import.meta.glob('../../content/games/**/*.{md,mdx}')).length;
const bookCount = Object.keys(import.meta.glob('../../content/books/**/*.{md,mdx}')).length;
const movieCount = Object.keys(import.meta.glob('../../content/movies/**/*.{md,mdx}')).length;

const categoryCount = new Set(posts.flatMap((post) => post.data.categories)).size;
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const startedAtMs = Date.parse(site.startedAt);
const daysOnline = Number.isFinite(startedAtMs)
  ? Math.max(1, Math.floor((Date.now() - startedAtMs) / 86_400_000) + 1)
  : 1;

const visibleSocial = site.social.filter((item) => item.show);
const trackingCount = animeCount + gameCount + bookCount + movieCount;

const backgroundPool = [
  '/images/placeholders/hero-01.placeholder.svg',
  '/images/placeholders/hero-02.placeholder.svg',
  '/images/placeholders/hero-03.placeholder.svg',
];

const stats = [
  { value: posts.length, label: t('home.dashboard.stat.posts') },
  { value: categoryCount, label: t('home.dashboard.stat.categories') },
  { value: tagCount, label: t('home.dashboard.stat.tags') },
  { value: daysOnline, label: t('home.dashboard.stat.days') },
];

const moduleCards = [
  {
    title: t('nav.gallery'),
    description: t('home.dashboard.module.gallery'),
    href: localizedPath('/gallery/', lang),
    icon: 'mdi:image-multiple-outline',
    count: galleryCount,
    accent: 'cyan',
  },
  {
    title: t('nav.projects'),
    description: t('home.dashboard.module.projects'),
    href: localizedPath('/projects/', lang),
    icon: 'mdi:source-branch',
    count: projectCount,
    accent: 'emerald',
  },
  {
    title: t('nav.tracking'),
    description: t('home.dashboard.module.tracking'),
    href: localizedPath('/tracking/anime/', lang),
    icon: 'mdi:radar',
    count: trackingCount,
    accent: 'amber',
  },
  {
    title: t('nav.moments'),
    description: t('home.dashboard.module.moments'),
    href: localizedPath('/moments/', lang),
    icon: 'mdi:message-processing-outline',
    count: momentCount,
    accent: 'rose',
  },
];
---

<section class="home-dashboard">
  <div
    class="home-dashboard__background"
    style={`background-image: linear-gradient(135deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.14)), url(${backgroundPool[0]});`}
    aria-hidden="true"
  ></div>

  <div class="home-dashboard__inner">
    <div class="home-dashboard__top">
      <article class="glass-strong profile-panel">
        <div class="profile-panel__media">
          <img src={site.author.avatar} alt={site.author.name[lang]} loading="eager" />
        </div>

        <div class="profile-panel__content">
          <p class="home-eyebrow">{t('home.dashboard.eyebrow')}</p>
          <h1>{site.title[lang]}</h1>
          <p class="profile-panel__subtitle">{site.subtitle[lang]}</p>
          <p class="profile-panel__bio">{site.author.bio[lang]}</p>

          <div class="profile-panel__actions" aria-label={t('home.dashboard.actions')}>
            <a href={localizedPath('/posts/', lang)} class="primary-action">
              <Icon name="mdi:text-box-multiple-outline" class="h-5 w-5" />
              <span>{t('home.dashboard.startReading')}</span>
            </a>
            <a href={localizedPath('/about/', lang)} class="secondary-action">
              <Icon name="mdi:account-circle-outline" class="h-5 w-5" />
              <span>{t('nav.about')}</span>
            </a>
          </div>

          {visibleSocial.length > 0 && (
            <div class="profile-panel__socials" aria-label={t('home.dashboard.socials')}>
              {visibleSocial.map((item) => (
                <a href={item.url} title={item.name} aria-label={item.name}>
                  <Icon name={item.icon} class="h-5 w-5" />
                </a>
              ))}
            </div>
          )}
        </div>
      </article>

      <aside class="home-dashboard__side">
        <form class="glass search-panel" action={localizedPath('/posts/', lang)} method="get">
          <label for="home-search" class="home-eyebrow">{t('home.dashboard.searchLabel')}</label>
          <div class="search-panel__field">
            <Icon name="mdi:magnify" class="h-5 w-5" />
            <input
              id="home-search"
              type="search"
              name="q"
              placeholder={t('home.dashboard.searchPlaceholder')}
              autocomplete="off"
            />
            <button type="submit" aria-label={t('common.search')}>
              <Icon name="mdi:arrow-right" class="h-5 w-5" />
            </button>
          </div>
        </form>

        <div class="stats-grid" aria-label={t('home.dashboard.stats')}>
          {stats.map((stat) => (
            <div class="glass stat-card">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>

    <div class="home-dashboard__main">
      <section class="glass-strong latest-panel" aria-labelledby="latest-posts-title">
        <div class="section-heading">
          <div>
            <p class="home-eyebrow">{t('home.dashboard.feed')}</p>
            <h2 id="latest-posts-title">{t('home.latestPosts')}</h2>
          </div>
          <a href={localizedPath('/posts/', lang)}>
            <span>{t('home.viewAll')}</span>
            <Icon name="mdi:arrow-right" class="h-4 w-4" />
          </a>
        </div>

        {latestPosts.length > 0 ? (
          <div class="latest-list">
            {latestPosts.map((post) => (
              <article class="latest-item">
                <a href={postUrl(post)} class="latest-item__link">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                  <h3>{post.data.title}</h3>
                  {post.data.description && <p>{post.data.description}</p>}
                  <div class="latest-item__meta">
                    {post.data.categories.slice(0, 2).map((category) => (
                      <span>{category}</span>
                    ))}
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span>#{tag}</span>
                    ))}
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <Icon name="mdi:sprout-outline" class="h-8 w-8" />
            <p>{t('home.dashboard.noPosts')}</p>
          </div>
        )}
      </section>

      <section class="modules-panel" aria-labelledby="modules-title">
        <div class="section-heading modules-heading">
          <div>
            <p class="home-eyebrow">{t('home.dashboard.shortcuts')}</p>
            <h2 id="modules-title">{t('home.dashboard.modules')}</h2>
          </div>
        </div>

        <div class="module-grid">
          {moduleCards.map((card) => (
            <a href={card.href} class={`glass module-card module-card--${card.accent}`}>
              <span class="module-card__icon">
                <Icon name={card.icon} class="h-6 w-6" />
              </span>
              <span class="module-card__body">
                <span class="module-card__title">{card.title}</span>
                <span class="module-card__desc">{card.description}</span>
              </span>
              <span class="module-card__count">
                {card.count > 0 ? card.count : t('home.dashboard.placeholder')}
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .home-dashboard {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - 6rem);
    overflow: hidden;
    padding: 1rem 1rem 4rem;
  }

  .home-dashboard__background {
    position: absolute;
    inset: -7rem 0 auto;
    z-index: -2;
    height: min(66rem, 100%);
    background-size: cover;
    background-position: center;
    opacity: 0.9;
  }

  .home-dashboard::before,
  .home-dashboard::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(18px);
    pointer-events: none;
  }

  .home-dashboard::before {
    top: 5%;
    right: -8rem;
    width: 20rem;
    height: 20rem;
    background: rgb(var(--color-brand-300) / 0.35);
  }

  .home-dashboard::after {
    bottom: 4rem;
    left: -7rem;
    width: 18rem;
    height: 18rem;
    background: rgb(14 165 233 / 0.2);
  }

  .home-dashboard__inner {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .home-dashboard__top,
  .home-dashboard__main {
    display: grid;
    gap: 1rem;
  }

  .profile-panel,
  .search-panel,
  .stat-card,
  .latest-panel,
  .module-card {
    border-radius: 1rem;
  }

  .profile-panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    min-width: 0;
    padding: 1.25rem;
  }

  .profile-panel__media {
    width: min(7rem, 38vw);
    aspect-ratio: 1;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.45);
    background: rgb(var(--color-surface) / 0.55);
    box-shadow: 0 16px 45px rgb(15 23 42 / 0.16);
  }

  .profile-panel__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-panel__content {
    min-width: 0;
  }

  .home-eyebrow {
    margin: 0 0 0.5rem;
    color: rgb(var(--color-brand-700));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  [data-theme='dark'] .home-eyebrow {
    color: rgb(var(--color-brand-200));
  }

  .profile-panel h1 {
    margin: 0;
    color: rgb(var(--color-ink));
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.25rem, 8vw, 4.6rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .profile-panel__subtitle {
    max-width: 42rem;
    margin: 0.8rem 0 0;
    color: rgb(var(--color-ink) / 0.88);
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .profile-panel__bio {
    max-width: 40rem;
    margin: 0.5rem 0 0;
    color: rgb(var(--color-muted));
    line-height: 1.8;
  }

  .profile-panel__actions,
  .profile-panel__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .primary-action,
  .secondary-action,
  .profile-panel__socials a,
  .search-panel button,
  .section-heading a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    border-radius: 999px;
    font-weight: 700;
  }

  .primary-action {
    gap: 0.5rem;
    padding: 0 1rem;
    color: white;
    background: rgb(var(--color-brand-600) / 0.9);
    box-shadow: 0 12px 30px rgb(var(--color-brand-700) / 0.24);
  }

  .primary-action:hover {
    color: white;
    background: rgb(var(--color-brand-700));
  }

  .secondary-action {
    gap: 0.5rem;
    padding: 0 1rem;
    color: rgb(var(--color-ink));
    background: rgb(var(--color-surface) / 0.48);
  }

  .profile-panel__socials a {
    width: 2.5rem;
    color: rgb(var(--color-ink));
    background: rgb(var(--color-surface) / 0.52);
  }

  .profile-panel__socials a:hover,
  .secondary-action:hover {
    color: rgb(var(--color-brand-700));
    background: rgb(var(--color-surface) / 0.75);
  }

  .home-dashboard__side {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .search-panel {
    padding: 1rem;
  }

  .search-panel__field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.25rem 0.35rem 0.25rem 0.85rem;
    border-radius: 999px;
    background: rgb(var(--color-surface) / 0.62);
    color: rgb(var(--color-muted));
  }

  .search-panel input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: rgb(var(--color-ink));
    font: inherit;
  }

  .search-panel input::placeholder {
    color: rgb(var(--color-muted) / 0.85);
  }

  .search-panel button {
    width: 2.5rem;
    border: 0;
    color: white;
    background: rgb(var(--color-brand-600));
    cursor: pointer;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .stat-card {
    min-width: 0;
    padding: 1rem;
  }

  .stat-card strong {
    display: block;
    color: rgb(var(--color-ink));
    font-size: clamp(1.5rem, 7vw, 2.25rem);
    line-height: 1;
  }

  .stat-card span {
    display: block;
    margin-top: 0.45rem;
    color: rgb(var(--color-muted));
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .home-dashboard__main {
    margin-top: 1rem;
  }

  .latest-panel {
    min-width: 0;
    padding: 1.1rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    color: rgb(var(--color-ink));
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.35rem, 5vw, 2rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .section-heading a {
    flex: 0 0 auto;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    color: rgb(var(--color-brand-700));
    background: rgb(var(--color-surface) / 0.5);
    font-size: 0.88rem;
  }

  .latest-list {
    display: grid;
    gap: 0.75rem;
  }

  .latest-item {
    min-width: 0;
  }

  .latest-item__link {
    display: block;
    padding: 0.95rem;
    border: 1px solid rgb(var(--glass-border) / 0.2);
    border-radius: 0.85rem;
    color: rgb(var(--color-ink));
    background: rgb(var(--color-surface) / 0.42);
  }

  .latest-item__link:hover {
    color: rgb(var(--color-ink));
    background: rgb(var(--color-surface) / 0.62);
  }

  .latest-item time {
    display: block;
    color: rgb(var(--color-muted));
    font-size: 0.78rem;
  }

  .latest-item h3 {
    display: -webkit-box;
    margin: 0.35rem 0 0;
    overflow: hidden;
    color: rgb(var(--color-ink));
    font-size: clamp(1rem, 4vw, 1.18rem);
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .latest-item p {
    display: -webkit-box;
    margin: 0.45rem 0 0;
    overflow: hidden;
    color: rgb(var(--color-muted));
    font-size: 0.9rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .latest-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .latest-item__meta span {
    max-width: 100%;
    overflow-wrap: anywhere;
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    color: rgb(var(--color-brand-800));
    background: rgb(var(--color-brand-100) / 0.55);
    font-size: 0.75rem;
  }

  .modules-panel {
    min-width: 0;
  }

  .modules-heading {
    margin: 0 0 0.75rem;
    padding: 0 0.15rem;
  }

  .module-grid {
    display: grid;
    gap: 0.75rem;
  }

  .module-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    min-height: 6.2rem;
    padding: 1rem;
    color: rgb(var(--color-ink));
  }

  .module-card:hover {
    color: rgb(var(--color-ink));
    transform: translateY(-2px);
  }

  .module-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.85rem;
    color: white;
    background: rgb(var(--color-brand-600));
    box-shadow: 0 12px 28px rgb(var(--color-brand-700) / 0.2);
  }

  .module-card--cyan .module-card__icon {
    background: rgb(8 145 178);
  }

  .module-card--emerald .module-card__icon {
    background: rgb(5 150 105);
  }

  .module-card--amber .module-card__icon {
    background: rgb(217 119 6);
  }

  .module-card--rose .module-card__icon {
    background: rgb(225 29 72);
  }

  .module-card__body {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .module-card__title {
    color: rgb(var(--color-ink));
    font-weight: 800;
  }

  .module-card__desc {
    display: -webkit-box;
    overflow: hidden;
    color: rgb(var(--color-muted));
    font-size: 0.86rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .module-card__count {
    justify-self: end;
    max-width: 5.2rem;
    overflow-wrap: anywhere;
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: rgb(var(--color-ink));
    background: rgb(var(--color-surface) / 0.56);
    font-size: 0.78rem;
    font-weight: 800;
    text-align: center;
  }

  .empty-state {
    display: grid;
    place-items: center;
    min-height: 11rem;
    border-radius: 0.85rem;
    color: rgb(var(--color-muted));
    background: rgb(var(--color-surface) / 0.38);
    text-align: center;
  }

  .empty-state p {
    margin: 0.65rem 0 0;
  }

  [data-theme='dark'] .home-dashboard__background {
    opacity: 0.34;
  }

  [data-theme='dark'] .secondary-action,
  [data-theme='dark'] .profile-panel__socials a,
  [data-theme='dark'] .search-panel__field,
  [data-theme='dark'] .section-heading a,
  [data-theme='dark'] .latest-item__link,
  [data-theme='dark'] .module-card__count,
  [data-theme='dark'] .empty-state {
    background: rgb(15 23 42 / 0.48);
  }

  [data-theme='dark'] .latest-item__meta span {
    color: rgb(var(--color-brand-100));
    background: rgb(var(--color-brand-900) / 0.45);
  }

  @media (min-width: 640px) {
    .home-dashboard {
      padding-inline: 1.5rem;
    }

    .profile-panel {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      padding: 1.5rem;
    }

    .module-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .home-dashboard {
      padding-top: 1.5rem;
      padding-bottom: 5rem;
    }

    .home-dashboard__top {
      grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 0.75fr);
      align-items: stretch;
    }

    .profile-panel {
      min-height: 26rem;
      padding: 2rem;
    }

    .home-dashboard__main {
      grid-template-columns: minmax(0, 1.2fr) minmax(22rem, 0.8fr);
      align-items: start;
    }

    .latest-panel {
      padding: 1.35rem;
    }
  }

  @media (max-width: 430px) {
    .home-dashboard {
      padding-inline: 0.75rem;
    }

    .section-heading {
      align-items: stretch;
      flex-direction: column;
    }

    .section-heading a {
      width: max-content;
      max-width: 100%;
    }

    .module-card {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .module-card__count {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
