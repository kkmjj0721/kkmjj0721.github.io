---
import { Icon } from "astro-icon/components";
import SearchModal from "@components/search/SearchModal.astro";
import { site } from "@data/site";
import { getLangFromUrl, localizedPath, useTranslations } from "@i18n/ui";
import { formatDate, getPublishedPosts, postUrl } from "@utils/posts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getPublishedPosts(lang);
const latestPosts = posts.slice(0, 4);

const galleryCount = Object.keys(
  import.meta.glob("../../content/gallery/**/*.{md,mdx}"),
).length;
const projectCount = Object.keys(
  import.meta.glob("../../content/projects/**/*.{md,mdx}"),
).length;
const momentCount = Object.keys(
  import.meta.glob("../../content/moments/**/*.{md,mdx}"),
).length;
const animeCount = Object.keys(
  import.meta.glob("../../content/anime/**/*.{md,mdx}"),
).length;
const gameCount = Object.keys(
  import.meta.glob("../../content/games/**/*.{md,mdx}"),
).length;
const bookCount = Object.keys(
  import.meta.glob("../../content/books/**/*.{md,mdx}"),
).length;
const movieCount = Object.keys(
  import.meta.glob("../../content/movies/**/*.{md,mdx}"),
).length;

const categoryCount = new Set(posts.flatMap((post) => post.data.categories))
  .size;
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const startedAtMs = Date.parse(site.startedAt);
const daysOnline = Number.isFinite(startedAtMs)
  ? Math.max(1, Math.floor((Date.now() - startedAtMs) / 86_400_000) + 1)
  : 1;

const visibleSocial = site.social.filter((item) => item.show);
const trackingCount = animeCount + gameCount + bookCount + movieCount;
const backgroundVideo = "/images/backgrounds/友利奈绪动态壁纸.mp4";

const stats = [
  { value: posts.length, label: t("home.dashboard.stat.posts") },
  { value: categoryCount, label: t("home.dashboard.stat.categories") },
  { value: tagCount, label: t("home.dashboard.stat.tags") },
  { value: daysOnline, label: t("home.dashboard.stat.days") },
];

const moduleCards = [
  {
    title: t("nav.gallery"),
    description: t("home.dashboard.module.gallery"),
    href: localizedPath("/gallery/", lang),
    icon: "mdi:image-multiple-outline",
    count: galleryCount,
    accent: "cyan",
  },
  {
    title: t("nav.projects"),
    description: t("home.dashboard.module.projects"),
    href: localizedPath("/projects/", lang),
    icon: "mdi:source-branch",
    count: projectCount,
    accent: "emerald",
  },
  {
    title: t("nav.tracking"),
    description: t("home.dashboard.module.tracking"),
    href: localizedPath("/tracking/anime/", lang),
    icon: "mdi:radar",
    count: trackingCount,
    accent: "amber",
  },
  {
    title: t("nav.moments"),
    description: t("home.dashboard.module.moments"),
    href: localizedPath("/moments/", lang),
    icon: "mdi:message-processing-outline",
    count: momentCount,
    accent: "rose",
  },
];
---

<section class="home-dashboard">
  <div class="home-dashboard__media" aria-hidden="true">
    <div class="home-dashboard__placeholder"></div>
    <video
      class="home-dashboard__video"
      src={backgroundVideo}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"></video>
    <div class="home-dashboard__overlay"></div>
  </div>

  <div class="home-dashboard__inner">
    <section
      class="home-dashboard__hero"
      aria-labelledby="home-dashboard-title"
    >
      <h1 id="home-dashboard-title">{site.title[lang]}</h1>
      <p class="home-dashboard__subtitle">{site.subtitle[lang]}</p>
      <p class="home-dashboard__bio">{site.author.bio[lang]}</p>

      <div
        class="home-dashboard__actions"
        aria-label={t("home.dashboard.actions")}
      >
        <a href={localizedPath("/posts/", lang)} class="primary-action">
          <Icon name="mdi:text-box-multiple-outline" class="h-5 w-5" />
          <span>{t("home.dashboard.startReading")}</span>
        </a>
        <a href={localizedPath("/about/", lang)} class="secondary-action">
          <Icon name="mdi:account-circle-outline" class="h-5 w-5" />
          <span>{t("nav.about")}</span>
        </a>
      </div>

      {
        visibleSocial.length > 0 && (
          <div
            class="home-dashboard__socials"
            aria-label={t("home.dashboard.socials")}
          >
            {visibleSocial.map((item) => (
              <a href={item.url} title={item.name} aria-label={item.name}>
                <Icon name={item.icon} class="h-5 w-5" />
              </a>
            ))}
          </div>
        )
      }
    </section>

    <div class="home-dashboard__content">
      <aside
        class="home-dashboard__utility"
        aria-label={t("home.dashboard.stats")}
      >
        <div class="glass search-panel">
          <p id="home-search-label" class="home-eyebrow">
            {t("home.dashboard.searchLabel")}
          </p>
          <button
            class="search-panel__field"
            type="button"
            data-search-open
            aria-labelledby="home-search-label"
            aria-controls="site-search-modal"
          >
            <Icon name="mdi:magnify" class="h-5 w-5" />
            <span class="search-panel__placeholder">
              {t("home.dashboard.searchPlaceholder")}
            </span>
            <span class="search-panel__action" aria-hidden="true">
              <Icon name="mdi:arrow-right" class="h-5 w-5" />
            </span>
          </button>
        </div>

        <div class="stats-grid">
          {
            stats.map((stat) => (
              <div class="glass stat-card">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))
          }
        </div>
      </aside>

      <section
        class="glass-strong latest-panel"
        aria-labelledby="latest-posts-title"
      >
        <div class="section-heading">
          <div>
            <p class="home-eyebrow">{t("home.dashboard.feed")}</p>
            <h2 id="latest-posts-title">{t("home.latestPosts")}</h2>
          </div>
          <a href={localizedPath("/posts/", lang)}>
            <span>{t("home.viewAll")}</span>
            <Icon name="mdi:arrow-right" class="h-4 w-4" />
          </a>
        </div>

        {
          latestPosts.length > 0 ? (
            <div class="latest-list">
              {latestPosts.map((post) => (
                <article class="latest-item">
                  <a href={postUrl(post)} class="latest-item__link">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate, lang)}
                    </time>
                    <h3>{post.data.title}</h3>
                    {post.data.description && <p>{post.data.description}</p>}
                    <div class="latest-item__meta">
                      {post.data.categories.slice(0, 2).map((category) => (
                        <span>{category}</span>
                      ))}
                      {post.data.tags.slice(0, 2).map((tag) => (
                        <span>#{tag}</span>
                      ))}
                    </div>
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <Icon name="mdi:sprout-outline" class="h-8 w-8" />
              <p>{t("home.dashboard.noPosts")}</p>
            </div>
          )
        }
      </section>

      <section class="modules-panel" aria-labelledby="modules-title">
        <div class="section-heading modules-heading">
          <div>
            <p class="home-eyebrow">{t("home.dashboard.shortcuts")}</p>
            <h2 id="modules-title">{t("home.dashboard.modules")}</h2>
          </div>
        </div>

        <div class="module-grid">
          {
            moduleCards.map((card) => (
              <a
                href={card.href}
                class={`glass module-card module-card--${card.accent}`}
              >
                <span class="module-card__icon">
                  <Icon name={card.icon} class="h-6 w-6" />
                </span>
                <span class="module-card__body">
                  <span class="module-card__title">{card.title}</span>
                  <span class="module-card__desc">{card.description}</span>
                </span>
                <span class="module-card__count">
                  {card.count > 0
                    ? card.count
                    : t("home.dashboard.placeholder")}
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</section>

<SearchModal lang={lang} placeholder={t("home.dashboard.searchPlaceholder")} />

<style>
  .home-dashboard {
    --home-ink: 15 23 42;
    --home-muted: 71 85 105;
    --home-soft: 51 65 85;
    --home-panel: 255 255 255;
    --home-border: 148 163 184;
    --home-shadow: 15 23 42;
    --home-surface-wash: 255 255 255;
    --home-field: 255 255 255;
    --home-item: 255 255 255;
    --home-pill: 241 245 249;
    --home-fallback-panel: 255 255 255;

    position: relative;
    isolation: isolate;
    height: 100vh;
    height: 100svh;
    margin-top: -3rem;
    overflow: hidden;
    padding: 4.8rem 1rem 1rem;
    color: rgb(var(--home-ink));
  }

  :global(html[data-theme="dark"]) .home-dashboard {
    --home-ink: 255 255 255;
    --home-muted: 226 232 240;
    --home-soft: 203 213 225;
    --home-panel: 255 255 255;
    --home-border: 255 255 255;
    --home-shadow: 0 0 0;
    --home-surface-wash: 15 23 42;
    --home-field: 15 23 42;
    --home-item: 15 23 42;
    --home-pill: 15 23 42;
    --home-fallback-panel: 15 23 42;
  }

  .home-dashboard__media {
    position: fixed;
    inset: 0;
    z-index: -3;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }

  .home-dashboard__placeholder {
    position: absolute;
    inset: 0;
    opacity: 1;
    background:
      radial-gradient(
        circle at 18% 16%,
        rgb(var(--color-brand-200) / 0.55),
        transparent 28rem
      ),
      radial-gradient(
        circle at 82% 22%,
        rgb(125 211 252 / 0.42),
        transparent 30rem
      ),
      radial-gradient(
        circle at 50% 92%,
        rgb(254 202 202 / 0.5),
        transparent 34rem
      ),
      linear-gradient(
        135deg,
        rgb(248 250 252),
        rgb(226 232 240) 48%,
        rgb(241 245 249)
      );
    transition: opacity 0.35s ease;
  }

  .home-dashboard__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: saturate(1.08) contrast(1.02);
    transition: opacity 0.35s ease;
  }

  .home-dashboard__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(2 6 23 / 0.74) 0%,
        rgb(15 23 42 / 0.32) 42%,
        rgb(2 6 23 / 0.82) 100%
      ),
      linear-gradient(
        90deg,
        rgb(2 6 23 / 0.38),
        rgb(2 6 23 / 0.08) 50%,
        rgb(2 6 23 / 0.42)
      );
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  :global(html[data-theme="dark"]) .home-dashboard__media {
    background:
      radial-gradient(
        circle at 18% 18%,
        rgb(var(--color-brand-400) / 0.38),
        transparent 34rem
      ),
      linear-gradient(135deg, rgb(25 32 60), rgb(94 57 116) 46%, rgb(16 24 39));
  }

  :global(html[data-theme="dark"]) .home-dashboard__placeholder {
    opacity: 0;
  }

  :global(html[data-theme="dark"]) .home-dashboard__video {
    opacity: 0.82;
  }

  :global(html[data-theme="dark"]) .home-dashboard__overlay {
    opacity: 1;
  }

  .home-dashboard__inner {
    width: min(1120px, 100%);
    margin: 0 auto;
    height: 100%;
    overflow: hidden;
  }

  .home-dashboard__hero {
    display: grid;
    justify-items: center;
    min-width: 0;
    padding: clamp(0.75rem, 3vw, 2rem) 0 clamp(1rem, 3vw, 2rem);
    text-align: center;
  }

  .home-dashboard a {
    color: inherit;
  }

  .home-eyebrow {
    margin: 0 0 0.7rem;
    color: rgb(var(--home-soft) / 0.88);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .home-dashboard__hero h1 {
    max-width: min(100%, 56rem);
    margin: 0;
    color: rgb(var(--home-ink));
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.35rem, 9vw, 5.7rem);
    line-height: 0.96;
    letter-spacing: 0;
    text-shadow: 0 18px 50px rgb(var(--home-shadow) / 0.18);
    overflow-wrap: anywhere;
  }

  .home-dashboard__subtitle {
    max-width: 46rem;
    margin: 0.75rem 0 0;
    color: rgb(var(--home-ink) / 0.94);
    font-size: clamp(1rem, 2.2vw, 1.32rem);
    font-weight: 700;
    line-height: 1.55;
    text-shadow: 0 8px 24px rgb(var(--home-shadow) / 0.14);
  }

  .home-dashboard__bio {
    max-width: 36rem;
    margin: 0.25rem 0 0;
    color: rgb(var(--home-muted) / 0.9);
    line-height: 1.55;
    text-shadow: 0 8px 22px rgb(var(--home-shadow) / 0.12);
  }

  .home-dashboard__actions,
  .home-dashboard__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 0.9rem;
    max-width: 100%;
  }

  .primary-action,
  .secondary-action,
  .home-dashboard__socials a,
  .search-panel__action,
  .section-heading a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.55rem;
    border-radius: 999px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 0.22s ease,
      background-color 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .primary-action,
  .secondary-action {
    gap: 0.5rem;
    max-width: 100%;
    padding: 0 1.1rem;
    white-space: nowrap;
  }

  .primary-action {
    color: white;
    background: rgb(var(--color-brand-600) / 0.96);
    box-shadow: 0 14px 38px rgb(var(--color-brand-700) / 0.38);
  }

  .primary-action:hover {
    color: white;
    background: rgb(var(--color-brand-700));
    transform: translateY(-2px);
  }

  .secondary-action,
  .home-dashboard__socials a {
    color: rgb(var(--home-ink));
    border: 1px solid rgb(var(--home-border) / 0.28);
    background: rgb(var(--home-panel) / 0.18);
    box-shadow:
      0 12px 34px rgb(var(--home-shadow) / 0.1),
      inset 0 1px 0 rgb(255 255 255 / 0.18);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
  }

  .secondary-action:hover,
  .home-dashboard__socials a:hover {
    color: rgb(var(--home-ink));
    border-color: rgb(var(--home-border) / 0.45);
    background: rgb(var(--home-panel) / 0.28);
    transform: translateY(-2px);
  }

  .home-dashboard__socials a {
    width: 2.55rem;
  }

  .home-dashboard__content {
    display: grid;
    gap: 1rem;
    min-width: 0;
    max-height: calc(100% - 16rem);
    overflow: hidden;
  }

  .home-dashboard__utility {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .home-dashboard .glass,
  .home-dashboard .glass-strong {
    color: rgb(var(--home-ink));
    border-color: rgb(var(--home-border) / 0.26);
    background: rgb(var(--home-panel) / 0.18);
    box-shadow:
      0 18px 50px rgb(var(--home-shadow) / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.2);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
  }

  .home-dashboard .glass-strong {
    background: rgb(var(--home-panel) / 0.24);
  }

  .search-panel,
  .stat-card,
  .latest-panel,
  .module-card {
    min-width: 0;
    border-radius: 1rem;
  }

  .search-panel {
    padding: 1rem;
  }

  .search-panel__field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    width: 100%;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.25rem 0.35rem 0.25rem 0.85rem;
    border: 1px solid rgb(var(--home-border) / 0.16);
    border-radius: 999px;
    background: rgb(var(--home-field) / 0.35);
    color: rgb(var(--home-muted));
    cursor: pointer;
    text-align: left;
  }

  .search-panel__field:hover {
    background: rgb(var(--home-field) / 0.48);
  }

  .search-panel__placeholder {
    display: block;
    min-width: 0;
    color: rgb(var(--home-ink));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-panel__action {
    width: 2.5rem;
    min-height: 2.5rem;
    border: 0;
    color: white;
    background: rgb(var(--color-brand-600));
  }

  .search-panel__field:hover .search-panel__action {
    background: rgb(var(--color-brand-700));
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .stat-card {
    padding: 1rem;
  }

  .stat-card strong {
    display: block;
    color: rgb(var(--home-ink));
    font-size: clamp(1.55rem, 7vw, 2.35rem);
    line-height: 1;
  }

  .stat-card span {
    display: block;
    margin-top: 0.45rem;
    color: rgb(var(--home-muted) / 0.88);
    font-size: 0.82rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .latest-panel {
    padding: 1.1rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    color: rgb(var(--home-ink));
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.35rem, 5vw, 2rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .section-heading a {
    flex: 0 0 auto;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    color: rgb(var(--home-ink));
    border: 1px solid rgb(var(--home-border) / 0.18);
    background: rgb(var(--home-panel) / 0.16);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .section-heading a:hover {
    background: rgb(var(--home-panel) / 0.25);
    transform: translateY(-1px);
  }

  .latest-list {
    display: grid;
    gap: 0.75rem;
  }

  .latest-item {
    min-width: 0;
  }

  .latest-item__link {
    display: block;
    padding: 0.95rem;
    border: 1px solid rgb(var(--home-border) / 0.16);
    border-radius: 0.85rem;
    color: rgb(var(--home-ink));
    background: rgb(var(--home-item) / 0.24);
    text-decoration: none;
  }

  .latest-item__link:hover {
    color: rgb(var(--home-ink));
    background: rgb(var(--home-item) / 0.34);
  }

  .latest-item time {
    display: block;
    color: rgb(var(--home-muted) / 0.78);
    font-size: 0.78rem;
  }

  .latest-item h3 {
    display: -webkit-box;
    margin: 0.35rem 0 0;
    overflow: hidden;
    color: rgb(var(--home-ink));
    font-size: clamp(1rem, 4vw, 1.18rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .latest-item p {
    display: -webkit-box;
    margin: 0.45rem 0 0;
    overflow: hidden;
    color: rgb(var(--home-muted) / 0.86);
    font-size: 0.9rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .latest-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .latest-item__meta span {
    max-width: 100%;
    overflow-wrap: anywhere;
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    color: rgb(var(--home-ink));
    background: rgb(var(--color-brand-600) / 0.22);
    font-size: 0.75rem;
  }

  .modules-panel {
    min-width: 0;
  }

  .modules-heading {
    margin: 0 0 0.75rem;
    padding: 0 0.15rem;
  }

  .module-grid {
    display: grid;
    gap: 0.75rem;
  }

  .module-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 5.3rem;
    padding: 1rem;
    text-decoration: none;
  }

  .module-card:hover {
    color: rgb(var(--home-ink));
    background: rgb(var(--home-panel) / 0.26);
    transform: translateY(-2px);
  }

  .module-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.85rem;
    color: white;
    background: rgb(var(--color-brand-600));
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.24);
  }

  .module-card--cyan .module-card__icon {
    background: rgb(8 145 178);
  }

  .module-card--emerald .module-card__icon {
    background: rgb(5 150 105);
  }

  .module-card--amber .module-card__icon {
    background: rgb(217 119 6);
  }

  .module-card--rose .module-card__icon {
    background: rgb(225 29 72);
  }

  .module-card__body {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .module-card__title {
    color: rgb(var(--home-ink));
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .module-card__desc {
    display: -webkit-box;
    overflow: hidden;
    color: rgb(var(--home-muted) / 0.86);
    font-size: 0.86rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .module-card__count {
    justify-self: end;
    max-width: 5.5rem;
    overflow-wrap: anywhere;
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: rgb(var(--home-ink));
