---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import SearchModal from "@components/search/SearchModal.astro";
import { site } from "@data/site";
import { getLangFromUrl, localizedPath, useTranslations } from "@i18n/ui";
import { formatDate, getPublishedPosts, postUrl } from "@utils/posts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getPublishedPosts(lang);
const latestPosts = posts.slice(0, 5);
const latestMoments = (
  await getCollection("moments", ({ data }) => data.visibility === "public")
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const galleryCount = Object.keys(
  import.meta.glob("../../content/gallery/**/*.{md,mdx}"),
).length;
const projectCount = Object.keys(
  import.meta.glob("../../content/projects/**/*.{md,mdx}"),
).length;
const momentCount = Object.keys(
  import.meta.glob("../../content/moments/**/*.{md,mdx}"),
).length;
const animeCount = Object.keys(
  import.meta.glob("../../content/anime/**/*.{md,mdx}"),
).length;
const gameCount = Object.keys(
  import.meta.glob("../../content/games/**/*.{md,mdx}"),
).length;
const bookCount = Object.keys(
  import.meta.glob("../../content/books/**/*.{md,mdx}"),
).length;
const movieCount = Object.keys(
  import.meta.glob("../../content/movies/**/*.{md,mdx}"),
).length;

const categoryCount = new Set(posts.flatMap((post) => post.data.categories))
  .size;
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const startedAtMs = Date.parse(site.startedAt);
const daysOnline = Number.isFinite(startedAtMs)
  ? Math.max(1, Math.floor((Date.now() - startedAtMs) / 86_400_000) + 1)
  : 1;

const visibleSocial = site.social.filter((item) => item.show);
const trackingCount = animeCount + gameCount + bookCount + movieCount;
const musicSrc = "/audio/bgm/Departures.mp3";

const copy = {
  zh: {
    profileKicker: "个人空间",
    online: "在线记录中",
    searchKicker: "SearchBar",
    playerKicker: "CloudPlayer",
    playerTitle: "Departures",
    playerArtist: "点击播放背景音乐",
    playerPlay: "播放音乐",
    playerPause: "暂停音乐",
    lyricIdle: "让音乐从一次点击开始。",
    lyricPlaying: "正在播放 Departures，背景与卡片保持轻盈透明。",
    lyricError: "浏览器暂时无法播放这首音乐。",
    postsKicker: "LatestPostsCarousel",
    chatterKicker: "LatestChatterCarousel",
    chatterTitle: "最近说说",
    chatterEmptyTitle: "说说待更新",
    chatterEmptyText: "短动态入口已经准备好，新的碎片想法会出现在这里。",
    themeKicker: "ThemeToggleBlock",
    themeTitle: "界面偏好",
    themeLight: "亮色",
    themeDark: "暗色",
    themeAuto: "自动",
    colorTitle: "主色",
    dashboardKicker: "SiteDashboard",
    dashboardTitle: "站点概览",
    modulesKicker: "快捷入口",
    readPost: "阅读文章",
    openMoments: "进入说说",
    waiting: "待整理",
  },
  en: {
    profileKicker: "Personal space",
    online: "Logging online",
    searchKicker: "SearchBar",
    playerKicker: "CloudPlayer",
    playerTitle: "Departures",
    playerArtist: "Click to play background music",
    playerPlay: "Play music",
    playerPause: "Pause music",
    lyricIdle: "Music starts with one click.",
    lyricPlaying: "Departures is playing while the glass cards stay light.",
    lyricError: "The browser could not play this track.",
    postsKicker: "LatestPostsCarousel",
    chatterKicker: "LatestChatterCarousel",
    chatterTitle: "Recent chatter",
    chatterEmptyTitle: "Chatter is waiting",
    chatterEmptyText: "Short updates are ready to appear here.",
    themeKicker: "ThemeToggleBlock",
    themeTitle: "Interface",
    themeLight: "Light",
    themeDark: "Dark",
    themeAuto: "Auto",
    colorTitle: "Accent",
    dashboardKicker: "SiteDashboard",
    dashboardTitle: "Site overview",
    modulesKicker: "Shortcuts",
    readPost: "Read post",
    openMoments: "Open moments",
    waiting: "Soon",
  },
}[lang];

const stats = [
  {
    value: posts.length,
    label: t("home.dashboard.stat.posts"),
    icon: "mdi:text-box-multiple-outline",
  },
  {
    value: categoryCount,
    label: t("home.dashboard.stat.categories"),
    icon: "mdi:folder-multiple-outline",
  },
  {
    value: tagCount,
    label: t("home.dashboard.stat.tags"),
    icon: "mdi:tag-multiple-outline",
  },
  {
    value: daysOnline,
    label: t("home.dashboard.stat.days"),
    icon: "mdi:calendar-clock",
  },
];

const moduleCards = [
  {
    title: t("nav.gallery"),
    description: t("home.dashboard.module.gallery"),
    href: localizedPath("/gallery/", lang),
    icon: "mdi:image-multiple-outline",
    count: galleryCount,
    accent: "cyan",
  },
  {
    title: t("nav.projects"),
    description: t("home.dashboard.module.projects"),
    href: localizedPath("/projects/", lang),
    icon: "mdi:source-branch",
    count: projectCount,
    accent: "emerald",
  },
  {
    title: t("nav.tracking"),
    description: t("home.dashboard.module.tracking"),
    href: localizedPath("/tracking/anime/", lang),
    icon: "mdi:radar",
    count: trackingCount,
    accent: "amber",
  },
  {
    title: t("nav.moments"),
    description: t("home.dashboard.module.moments"),
    href: localizedPath("/moments/", lang),
    icon: "mdi:message-processing-outline",
    count: momentCount,
    accent: "rose",
  },
];

const dashboardItems = [
  ...stats,
  {
    value: galleryCount + projectCount,
    label: `${t("nav.gallery")} / ${t("nav.projects")}`,
    icon: "mdi:view-dashboard-outline",
  },
  {
    value: trackingCount,
    label: t("nav.tracking"),
    icon: "mdi:cards-heart-outline",
  },
];
---

<section
  class="home-dashboard"
  data-lyric-idle={copy.lyricIdle}
  data-lyric-playing={copy.lyricPlaying}
  data-lyric-error={copy.lyricError}
  data-player-play-label={copy.playerPlay}
  data-player-pause-label={copy.playerPause}
>
  <div class="home-dashboard__inner">
    <div class="home-dashboard__layout">
      <aside class="home-stack home-stack--profile">
        <article class="home-glass profile-card" aria-labelledby="home-title">
          <div class="profile-card__topline">
            <span>{copy.profileKicker}</span>
            <span class="profile-card__status">
              <span aria-hidden="true"></span>
              {copy.online}
            </span>
          </div>

          <div class="profile-card__identity">
            <img
              src={site.author.avatar}
              alt={site.author.name[lang]}
              loading="eager"
              class="profile-card__avatar"
            />
            <div>
              <h1 id="home-title">{site.title[lang]}</h1>
              <p>{site.author.nameAlias[lang]}</p>
            </div>
          </div>

          <p class="profile-card__subtitle">{site.subtitle[lang]}</p>
          <p class="profile-card__bio">{site.author.bio[lang]}</p>

          {
            visibleSocial.length > 0 && (
              <div
                class="profile-card__socials"
                aria-label={t("home.dashboard.socials")}
              >
                {visibleSocial.map((item) => (
                  <a href={item.url} title={item.name} aria-label={item.name}>
                    <Icon name={item.icon} class="h-5 w-5" />
                  </a>
                ))}
              </div>
            )
          }

          <div
            class="profile-card__actions"
            aria-label={t("home.dashboard.actions")}
          >
            <a href={localizedPath("/posts/", lang)} class="home-action">
              <Icon name="mdi:text-box-multiple-outline" class="h-5 w-5" />
              <span>{t("home.dashboard.startReading")}</span>
            </a>
            <a
              href={localizedPath("/about/", lang)}
              class="home-action home-action--quiet"
            >
              <Icon name="mdi:account-circle-outline" class="h-5 w-5" />
              <span>{t("nav.about")}</span>
            </a>
          </div>
        </article>

        <section
          class="home-glass search-card"
          aria-labelledby="home-search-label"
        >
          <p class="home-kicker" id="home-search-label">{copy.searchKicker}</p>
          <button
            class="search-card__field"
            type="button"
            data-search-open
            aria-controls="site-search-modal"
          >
            <Icon name="mdi:magnify" class="h-5 w-5" />
            <span>{t("home.dashboard.searchPlaceholder")}</span>
            <Icon name="mdi:arrow-right" class="h-5 w-5" />
          </button>
        </section>

        <section
          class="home-glass player-card"
          data-home-player
          aria-labelledby="home-player-title"
        >
          <audio data-home-audio src={musicSrc} preload="metadata"></audio>
          <div class="panel-heading panel-heading--compact">
            <div>
              <p class="home-kicker">{copy.playerKicker}</p>
              <h2 id="home-player-title">{copy.playerTitle}</h2>
            </div>
            <button
              type="button"
              class="player-toggle"
              data-home-audio-toggle
              aria-label={copy.playerPlay}
              aria-pressed="false"
            >
              <Icon
                name="mdi:play"
                class="player-toggle__play h-6 w-6"
                aria-hidden="true"
              />
              <Icon
                name="mdi:pause"
                class="player-toggle__pause h-6 w-6"
                aria-hidden="true"
              />
            </button>
          </div>

          <div class="player-card__track">
            <span class="player-card__disc" aria-hidden="true">
              <Icon name="mdi:music" class="h-5 w-5" />
            </span>
            <div>
              <strong>{copy.playerTitle}</strong>
              <span>{copy.playerArtist}</span>
            </div>
          </div>

          <div
            class="player-progress"
            data-home-audio-progress
            aria-hidden="true"
          >
            <span></span>
          </div>

          <div class="lyric-bar">
            <Icon name="mdi:music-note-outline" class="h-4 w-4" />
            <p data-home-lyric>{copy.lyricIdle}</p>
          </div>
        </section>
      </aside>

      <div class="home-stack home-stack--feed">
        <section
          class="home-glass posts-carousel"
          aria-labelledby="latest-posts-title"
        >
          <div class="panel-heading">
            <div>
              <p class="home-kicker">{copy.postsKicker}</p>
              <h2 id="latest-posts-title">{t("home.latestPosts")}</h2>
            </div>
            <a href={localizedPath("/posts/", lang)} class="panel-link">
              <span>{t("home.viewAll")}</span>
              <Icon name="mdi:arrow-right" class="h-4 w-4" />
            </a>
          </div>

          {
            latestPosts.length > 0 ? (
              <div class="rail" tabindex="0" aria-label={t("home.latestPosts")}>
                {latestPosts.map((post) => (
                  <article class="post-card">
                    <a
                      href={postUrl(post)}
                      aria-label={`${copy.readPost}: ${post.data.title}`}
                    >
                      <time datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate, lang)}
                      </time>
                      <h3>{post.data.title}</h3>
                      {post.data.description && <p>{post.data.description}</p>}
                      <span class="post-card__footer">
                        <span>{post.data.categories[0] ?? t("nav.posts")}</span>
                        <Icon name="mdi:chevron-right" class="h-5 w-5" />
                      </span>
                    </a>
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <Icon name="mdi:sprout-outline" class="h-8 w-8" />
                <p>{t("home.dashboard.noPosts")}</p>
              </div>
            )
          }
        </section>

        <section
          class="home-glass chatter-carousel"
          aria-labelledby="latest-chatter-title"
        >
          <div class="panel-heading">
            <div>
              <p class="home-kicker">{copy.chatterKicker}</p>
              <h2 id="latest-chatter-title">{copy.chatterTitle}</h2>
            </div>
            <a href={localizedPath("/moments/", lang)} class="panel-link">
              <span>{copy.openMoments}</span>
              <Icon name="mdi:arrow-right" class="h-4 w-4" />
            </a>
          </div>

          <div class="chatter-grid">
            {
              latestMoments.length > 0 ? (
                latestMoments.map((moment) => (
                  <a
                    href={localizedPath("/moments/", lang)}
                    class="chatter-card"
                  >
                    <time datetime={moment.data.date.toISOString()}>
                      {formatDate(moment.data.date, lang)}
                    </time>
                    <h3>{moment.data.mood ?? t("nav.moments")}</h3>
                    <p>
                      {moment.data.location
                        ? `${moment.data.location} · ${moment.data.images.length} images`
                        : moment.data.images.length > 0
                          ? `${moment.data.images.length} images`
                          : t("home.dashboard.module.moments")}
                    </p>
                  </a>
                ))
              ) : (
                <a
                  href={localizedPath("/moments/", lang)}
                  class="chatter-card chatter-card--empty"
                >
                  <time>{copy.waiting}</time>
                  <h3>{copy.chatterEmptyTitle}</h3>
                  <p>{copy.chatterEmptyText}</p>
                </a>
              )
            }
          </div>
        </section>

        <section class="module-strip" aria-label={copy.modulesKicker}>
          {
            moduleCards.map((card) => (
              <a
                href={card.href}
                class={`home-glass module-chip module-chip--${card.accent}`}
              >
                <span class="module-chip__icon">
                  <Icon name={card.icon} class="h-5 w-5" />
                </span>
                <span class="module-chip__body">
                  <span>{card.title}</span>
                  <small>{card.description}</small>
                </span>
                <strong>
                  {card.count > 0
                    ? card.count
                    : t("home.dashboard.placeholder")}
                </strong>
              </a>
            ))
          }
        </section>
      </div>

      <aside class="home-stack home-stack--dashboard">
        <section
          class="home-glass theme-card"
          aria-labelledby="home-theme-title"
        >
          <p class="home-kicker">{copy.themeKicker}</p>
          <div class="panel-heading panel-heading--compact">
            <h2 id="home-theme-title">{copy.themeTitle}</h2>
            <Icon name="mdi:theme-light-dark" class="h-5 w-5" />
          </div>

          <div class="theme-card__modes" aria-label={copy.themeTitle}>
            <button type="button" data-home-theme-mode="light">
              <Icon name="mdi:white-balance-sunny" class="h-4 w-4" />
              <span>{copy.themeLight}</span>
            </button>
            <button type="button" data-home-theme-mode="dark">
              <Icon name="mdi:weather-night" class="h-4 w-4" />
              <span>{copy.themeDark}</span>
            </button>
            <button type="button" data-home-theme-mode="auto">
              <Icon name="mdi:theme-light-dark" class="h-4 w-4" />
              <span>{copy.themeAuto}</span>
            </button>
          </div>

          <div class="theme-card__colors" aria-label={copy.colorTitle}>
            <span>{copy.colorTitle}</span>
            <div>
              {
                site.brand.presets.map((preset) => (
                  <button
                    type="button"
                    data-home-brand-color={preset.value}
                    aria-label={preset.name}
                    title={preset.name}
                    style={`--swatch: ${preset.value}`}
                  />
                ))
              }
            </div>
          </div>
        </section>

        <section
          class="home-glass site-dashboard"
          aria-labelledby="site-dashboard-title"
        >
          <p class="home-kicker">{copy.dashboardKicker}</p>
          <div class="panel-heading panel-heading--compact">
            <h2 id="site-dashboard-title">{copy.dashboardTitle}</h2>
            <Icon name="mdi:chart-box-outline" class="h-5 w-5" />
          </div>

          <div class="site-dashboard__grid">
            {
              dashboardItems.map((item) => (
                <div class="dashboard-stat">
                  <Icon name={item.icon} class="h-5 w-5" />
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                </div>
              ))
            }
          </div>
        </section>
      </aside>
    </div>
  </div>
</section>

<SearchModal lang={lang} placeholder={t("home.dashboard.searchPlaceholder")} />

<script>
  declare global {
    interface Window {
      __homeDashboardController?: AbortController;
      __homeDashboardPageLoadBound?: boolean;
    }
  }

  const initHomeDashboard = () => {
    window.__homeDashboardController?.abort();

    const controller = new AbortController();
    window.__homeDashboardController = controller;
    const { signal } = controller;

    const dashboard = document.querySelector<HTMLElement>(".home-dashboard");
    const root = document.documentElement;

    const player = document.querySelector<HTMLElement>("[data-home-player]");
    const audio = document.querySelector<HTMLAudioElement>("[data-home-audio]");
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-home-audio-toggle]",
    );
    const progress = document.querySelector<HTMLElement>(
      "[data-home-audio-progress]",
    );
    const lyric = document.querySelector<HTMLElement>("[data-home-lyric]");
    const lyricIdle = dashboard?.dataset.lyricIdle ?? "";
    const lyricPlaying = dashboard?.dataset.lyricPlaying ?? "";
    const lyricError = dashboard?.dataset.lyricError ?? "";
    const playerPlayLabel = dashboard?.dataset.playerPlayLabel ?? "";
    const playerPauseLabel = dashboard?.dataset.playerPauseLabel ?? "";

    const updatePlayerState = () => {
      const isPlaying = Boolean(audio && !audio.paused);
      player?.classList.toggle("is-playing", isPlaying);
      if (toggle) {
        toggle.setAttribute("aria-pressed", String(isPlaying));
        toggle.setAttribute(
          "aria-label",
          isPlaying ? playerPauseLabel : playerPlayLabel,
        );
      }
      if (lyric) {
        lyric.textContent = isPlaying ? lyricPlaying : lyricIdle;
      }
    };

    const updateProgress = () => {
      if (!audio || !progress || !Number.isFinite(audio.duration)) {
        progress?.style.setProperty("--progress", "0%");
        return;
      }
      const percent = Math.min(100, (audio.currentTime / audio.duration) * 100);
      progress.style.setProperty("--progress", `${percent}%`);
    };

    toggle?.addEventListener(
      "click",
      () => {
        if (!audio) return;
        if (audio.paused) {
          void audio.play().catch(() => {
            if (lyric) lyric.textContent = lyricError;
          });
        } else {
          audio.pause();
        }
      },
      { signal },
    );

    audio?.addEventListener("play", updatePlayerState, { signal });
    audio?.addEventListener("pause", updatePlayerState, { signal });
    audio?.addEventListener("ended", updatePlayerState, { signal });
    audio?.addEventListener("timeupdate", updateProgress, { signal });
    audio?.addEventListener("loadedmetadata", updateProgress, { signal });
    updatePlayerState();
    updateProgress();

    const resolveTheme = (mode: string) => {
      if (mode === "auto") {
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }
      return mode === "dark" ? "dark" : "light";
    };

    const syncThemeButtons = () => {
      let saved = "auto";
      try {
        saved = localStorage.getItem("blog:theme") || "auto";
      } catch {}
      document
        .querySelectorAll<HTMLButtonElement>("[data-home-theme-mode]")
        .forEach((button) => {
          const isActive = button.dataset.homeThemeMode === saved;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
    };

    document
      .querySelectorAll<HTMLButtonElement>("[data-home-theme-mode]")
      .forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const mode = button.dataset.homeThemeMode ?? "auto";
            root.setAttribute("data-theme", resolveTheme(mode));
            try {
              localStorage.setItem("blog:theme", mode);
            } catch {}
            syncThemeButtons();
          },
          { signal },
        );
      });

    const mixChannel = (channel: number, target: number, amount: number) =>
      Math.round(channel + (target - channel) * amount);

    const setBrandColor = (hex: string) => {
      const value = hex.replace("#", "");
      const r = Number.parseInt(value.slice(0, 2), 16);
      const g = Number.parseInt(value.slice(2, 4), 16);
      const b = Number.parseInt(value.slice(4, 6), 16);
      if (![r, g, b].every(Number.isFinite)) return;

      const mix = (target: number, amount: number) =>
        `${mixChannel(r, target, amount)} ${mixChannel(g, target, amount)} ${mixChannel(b, target, amount)}`;

      const scale = {
        50: mix(255, 0.94),
        100: mix(255, 0.88),
        200: mix(255, 0.75),
        300: mix(255, 0.55),
        400: mix(255, 0.34),
        500: mix(255, 0.12),
        600: `${r} ${g} ${b}`,
        700: mix(0, 0.14),
        800: mix(0, 0.28),
        900: mix(0, 0.42),
      };

      root.style.setProperty("--color-brand", scale[600]);
      for (const [key, color] of Object.entries(scale)) {
        root.style.setProperty(`--color-brand-${key}`, color);
      }
      try {
        localStorage.setItem("blog:brand-color", hex);
      } catch {}
    };

    const syncBrandButtons = () => {
      let saved = "";
      try {
        saved = localStorage.getItem("blog:brand-color") || "";
      } catch {}
      document
        .querySelectorAll<HTMLButtonElement>("[data-home-brand-color]")
        .forEach((button) => {
          const isActive =
            button.dataset.homeBrandColor?.toLowerCase() ===
            saved.toLowerCase();
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
    };

    document
      .querySelectorAll<HTMLButtonElement>("[data-home-brand-color]")
      .forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const color = button.dataset.homeBrandColor;
            if (!color) return;
            setBrandColor(color);
            syncBrandButtons();
          },
          { signal },
        );
      });

    syncThemeButtons();
    syncBrandButtons();
  };

  initHomeDashboard();

  if (!window.__homeDashboardPageLoadBound) {
    document.addEventListener("astro:page-load", initHomeDashboard);
    window.__homeDashboardPageLoadBound = true;
  }
</script>

<style>
  .home-dashboard {
    --home-ink: 15 23 42;
    --home-muted: 71 85 105;
    --home-soft: 100 116 139;
    --home-glass: 255 255 255;
    --home-glass-alpha: 0.42;
    --home-glass-hover-alpha: 0.58;
    --home-border: 255 255 255;
    --home-border-alpha: 0.5;
    --home-shadow: 15 23 42;
    --home-chip: 255 255 255;

    position: relative;
    isolation: isolate;
    height: 100vh;
    height: 100svh;
    margin-top: -3rem;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 4.75rem 0.85rem 1rem;
    color: rgb(var(--home-ink));
    overscroll-behavior: contain;
  }

  :global(html[data-theme="dark"]) .home-dashboard {
    --home-ink: 248 250 252;
    --home-muted: 203 213 225;
    --home-soft: 148 163 184;
    --home-glass: 2 6 23;
    --home-glass-alpha: 0.36;
    --home-glass-hover-alpha: 0.5;
    --home-border: 255 255 255;
