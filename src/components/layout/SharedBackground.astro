---
const lightBackgroundVideo = "/images/backgrounds/tomori-light.mp4";
const darkBackgroundVideo = "/images/backgrounds/tomori-dark.mp4";
const lightBackgroundPoster = "/images/backgrounds/tomori-light-poster.webp";
const darkBackgroundPoster = "/images/backgrounds/tomori-dark-poster.webp";
---

<div
  class="site-background"
  data-site-background
  aria-hidden="true"
  transition:persist="site-background"
>
  <div
    class="site-background__poster"
    data-site-background-poster
    data-src-light={lightBackgroundPoster}
    data-src-dark={darkBackgroundPoster}
  >
  </div>
  <video
    class="site-background__video site-background__video--light"
    data-site-background-video
    data-src-light={lightBackgroundVideo}
    data-src-dark={darkBackgroundVideo}
    data-poster-light={lightBackgroundPoster}
    data-poster-dark={darkBackgroundPoster}
    poster={lightBackgroundPoster}
    autoplay
    muted
    loop
    playsinline
    preload="auto"></video>
  <div class="site-background__overlay"></div>
</div>

<script is:inline>
  // 在 DOM 解析时立刻给 video 设 src，让浏览器尽早开始下载。
  // 此时 BaseLayout 的 head 内联脚本已写好 data-theme。
  (function () {
    var v = document.querySelector("[data-site-background-video]");
    if (!v || v.getAttribute("src")) return;
    var poster = document.querySelector("[data-site-background-poster]");
    var theme =
      document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";
    var src = theme === "dark" ? v.dataset.srcDark : v.dataset.srcLight;
    var posterSrc =
      theme === "dark" ? v.dataset.posterDark : v.dataset.posterLight;
    if (!src) return;
    v.classList.toggle("site-background__video--dark", theme === "dark");
    v.classList.toggle("site-background__video--light", theme !== "dark");
    if (poster) poster.dataset.theme = theme;
    if (posterSrc) v.setAttribute("poster", posterSrc);
    v.setAttribute("src", src);
  })();
</script>

<script>
  declare global {
    interface Window {
      __siteBackgroundController?: AbortController;
      __siteBackgroundBound?: boolean;
    }
  }

  const initSiteBackground = () => {
    window.__siteBackgroundController?.abort();

    const controller = new AbortController();
    window.__siteBackgroundController = controller;
    const { signal } = controller;

    const root = document.documentElement;
    const background = document.querySelector<HTMLElement>(
      "[data-site-background]",
    );
    const video = document.querySelector<HTMLVideoElement>(
      "[data-site-background-video]",
    );

    if (!background || !video) return;

    const setReady = (isReady: boolean) => {
      background.classList.toggle("is-video-ready", isReady);
      video.classList.toggle("is-video-ready", isReady);
    };

    // 持久化的视频可能已经处于 ready 状态（readyState >= 2 = HAVE_CURRENT_DATA）
    if (video.readyState >= 2) setReady(true);

    const syncVideoSource = () => {
      const theme =
        root.getAttribute("data-theme") === "dark" ? "dark" : "light";
      const nextSrc =
        theme === "dark" ? video.dataset.srcDark : video.dataset.srcLight;
      const nextPoster =
        theme === "dark"
          ? video.dataset.posterDark
          : video.dataset.posterLight;

      background.dataset.theme = theme;
      video.classList.toggle("site-background__video--dark", theme === "dark");
      video.classList.toggle("site-background__video--light", theme !== "dark");
      if (nextPoster) video.setAttribute("poster", nextPoster);

      if (!nextSrc) return;

      // 只在 src 真的不同时才换源（避免持久化的视频被无意义 reload）
      const currentSrc = video.getAttribute("src");
      const needsReload =
        !currentSrc ||
        (!currentSrc.endsWith(nextSrc) && !currentSrc.includes(nextSrc));
      if (needsReload) {
        setReady(false);
        video.pause();
        video.setAttribute("src", nextSrc);
        video.load();
      }

      void video.play().catch(() => {});
    };

    video.addEventListener("loadeddata", () => setReady(true), { signal });
    video.addEventListener("canplay", () => setReady(true), { signal });
    video.addEventListener("error", () => setReady(false), { signal });

    const observer = new MutationObserver(syncVideoSource);
    observer.observe(root, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    signal.addEventListener("abort", () => observer.disconnect(), {
      once: true,
    });

    syncVideoSource();
  };

  initSiteBackground();

  if (!window.__siteBackgroundBound) {
    // 切页后 (video 持久化保留)，重新绑定 observer 到当前 documentElement
    document.addEventListener("astro:page-load", initSiteBackground);
    window.__siteBackgroundBound = true;
  }
</script>

<style>
  .site-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }

  .site-background__poster,
  .site-background__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-background__poster {
    background-image: url("/images/backgrounds/tomori-light-poster.webp");
    background-position: center;
    background-size: cover;
    opacity: 0.92;
    filter: saturate(1.03) contrast(0.98) brightness(1.04);
    transition: opacity 0.35s ease;
  }

  :global(html[data-theme="dark"]) .site-background__poster {
    background-image: url("/images/backgrounds/tomori-dark-poster.webp");
    opacity: 0.86;
    filter: saturate(1.08) contrast(1.02);
  }

  .site-background.is-video-ready .site-background__poster {
    opacity: 0;
  }

  .site-background__video {
    object-fit: cover;
    opacity: 0;
    filter: saturate(1.08) contrast(1.02);
    transition: opacity 0.35s ease;
  }

  .site-background__video--light.is-video-ready {
    opacity: 0.92;
    filter: saturate(1.03) contrast(0.98) brightness(1.04);
  }

  .site-background__video--dark.is-video-ready {
    opacity: 0.86;
  }

  .site-background__overlay {
    position: absolute;
    inset: 0;
    opacity: 1;
    background:
      linear-gradient(
        180deg,
        rgb(255 255 255 / 0.46) 0%,
        rgb(255 255 255 / 0.18) 42%,
        rgb(255 255 255 / 0.36) 100%
      ),
      linear-gradient(
        90deg,
        rgb(255 255 255 / 0.34),
        rgb(255 255 255 / 0.08) 52%,
        rgb(255 255 255 / 0.3)
      );
    transition: opacity 0.35s ease;
  }

  :global(html[data-theme="dark"]) .site-background__overlay {
    background:
      linear-gradient(
        180deg,
        rgb(2 6 23 / 0.52) 0%,
        rgb(15 23 42 / 0.18) 42%,
        rgb(2 6 23 / 0.58) 100%
      ),
      linear-gradient(
        90deg,
        rgb(2 6 23 / 0.22),
        rgb(2 6 23 / 0.04) 52%,
        rgb(2 6 23 / 0.28)
      );
  }
</style>
