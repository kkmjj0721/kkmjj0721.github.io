---
import { Icon } from 'astro-icon/components';
import { site } from '@data/site';
import { getLangFromUrl } from '@i18n/ui';

const lang = getLangFromUrl(Astro.url);
const socials = site.social.filter((s) => s.show);
const year = new Date().getFullYear();
const startedYear = new Date(site.startedAt).getFullYear();
const yearText = startedYear === year ? `${year}` : `${startedYear} – ${year}`;
---

<footer class="mt-16 pb-10 px-4">
  <div class="mx-auto max-w-5xl glass p-6 text-center">
    <div class="flex justify-center gap-3 mb-4 flex-wrap">
      {socials.map((s) => (
        <a
          href={s.url}
          target={s.url.startsWith('http') ? '_blank' : undefined}
          rel="noopener noreferrer"
          aria-label={s.name}
          class="p-2 rounded-full bg-white/30 dark:bg-white/10 hover:bg-brand-100/60 dark:hover:bg-brand-900/40 transition-colors hover:-translate-y-0.5"
        >
          <Icon name={s.icon} class="w-5 h-5" />
        </a>
      ))}
    </div>

    <p class="text-sm text-muted mb-2">
      © {yearText} <span class="font-semibold">{site.author.name[lang]}</span> · {site.title[lang]}
    </p>
    <p class="text-xs text-muted mb-2">
      Built with <a href="https://astro.build" target="_blank" rel="noopener" class="hover:underline">Astro</a>
      · Hosted on <a href="https://pages.github.com" target="_blank" rel="noopener" class="hover:underline">GitHub Pages</a>
    </p>
    <p class="text-xs text-muted">
      <span data-uptime>已运行 — 天</span>
      {site.icp && <span class="ml-2">· {site.icp}</span>}
    </p>
  </div>
</footer>

<script define:vars={{ startedAt: site.startedAt }}>
  const start = new Date(startedAt).getTime();
  const days = Math.max(0, Math.floor((Date.now() - start) / (1000 * 60 * 60 * 24)));
  document.querySelectorAll('[data-uptime]').forEach((el) => {
    el.textContent = `已运行 ${days} 天`;
  });
</script>
