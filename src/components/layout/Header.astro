---
import { Icon } from "astro-icon/components";
import { site } from "@data/site";
import { nav } from "@data/nav";
import { getLangFromUrl, useTranslations, localizedPath } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const title = site.title[lang];
const [titleBefore, ...titleAfterParts] = title.split("の");
const titleAfter = titleAfterParts.join("の");
const navLabel = lang === "zh" ? "主导航" : "Primary navigation";
const menuLabel = lang === "zh" ? "导航菜单" : "Navigation menu";

const normalizePath = (path: string) => {
  const clean = path.replace(/\/+$/, "");
  return clean || "/";
};

const currentPath = normalizePath(Astro.url.pathname);
const navItems = nav.map((item) => {
  const href = localizedPath(item.href, lang);
  const matchHref = "match" in item ? item.match : item.href;
  const target = normalizePath(localizedPath(matchHref, lang));
  const isHome = normalizePath(matchHref) === "/";
  const isActive = isHome
    ? currentPath === target
    : currentPath === target || currentPath.startsWith(`${target}/`);

  return {
    ...item,
    href,
    isActive,
    label: t(`nav.${item.key}`),
  };
});
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-2 sm:px-5" data-site-header>
  <nav
    class="mx-auto flex min-h-10 w-full max-w-6xl items-center justify-between gap-3 rounded-full border border-white/55 bg-white/55 px-3 py-2 text-slate-950 shadow-lg shadow-slate-950/10 backdrop-blur-xl backdrop-saturate-150 dark:border-white/10 dark:bg-slate-950/55 dark:text-slate-50 dark:shadow-black/25 sm:px-4 lg:px-5"
    aria-label={navLabel}
  >
    <a
      href={localizedPath("/", lang)}
      class="min-w-0 truncate font-serif text-base font-black text-slate-950 transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/45 focus-visible:ring-offset-2 focus-visible:ring-offset-white/70 dark:text-white dark:hover:text-brand-300 dark:focus-visible:ring-brand-300/70 dark:focus-visible:ring-offset-slate-950/80 sm:text-lg"
    >
      {
        titleAfter ? (
          <>
            <span>{titleBefore}</span>
            <span class="mx-1 text-brand-600 dark:text-brand-300">の</span>
            <span>{titleAfter}</span>
          </>
        ) : (
          title
        )
      }
    </a>

    <ul class="hidden items-center gap-1 text-sm font-bold lg:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.isActive ? "page" : undefined}
              class:list={[
                "relative rounded-full px-2.5 py-1.5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/45 focus-visible:ring-offset-2 focus-visible:ring-offset-white/70 dark:focus-visible:ring-brand-300/70 dark:focus-visible:ring-offset-slate-950/80",
                item.isActive
                  ? "text-brand-700 dark:text-brand-300"
                  : "text-slate-700 hover:bg-white/45 hover:text-brand-700 dark:text-slate-200 dark:hover:bg-white/10 dark:hover:text-brand-300",
              ]}
            >
              <span>{item.label}</span>
              {item.isActive && (
                <span
                  class="absolute -bottom-0.5 left-1/2 h-1 w-1 -translate-x-1/2 rounded-full bg-brand-500 dark:bg-brand-300"
                  aria-hidden="true"
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      id="mobile-menu-btn"
      aria-label={menuLabel}
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/40 bg-white/45 text-slate-950 transition-colors hover:bg-white/70 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/45 focus-visible:ring-offset-2 focus-visible:ring-offset-white/70 dark:border-white/10 dark:bg-white/10 dark:text-slate-50 dark:hover:bg-white/15 dark:hover:text-brand-300 dark:focus-visible:ring-brand-300/70 dark:focus-visible:ring-offset-slate-950/80 lg:hidden"
    >
      <Icon name="mdi:menu" class="h-5 w-5" data-menu-icon />
      <Icon name="mdi:close" class="hidden h-5 w-5" data-close-icon />
    </button>
  </nav>

  <div
    id="mobile-menu"
    tabindex="-1"
    class="mx-auto mt-2 hidden max-h-[calc(100svh-5rem)] w-full max-w-md overflow-y-auto rounded-2xl border border-white/55 bg-white/70 p-2 text-slate-950 shadow-xl shadow-slate-950/10 backdrop-blur-xl backdrop-saturate-150 dark:border-white/10 dark:bg-slate-950/70 dark:text-slate-50 dark:shadow-black/30 lg:hidden"
  >
    <ul class="grid grid-cols-2 gap-1.5">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.isActive ? "page" : undefined}
              class:list={[
                "flex min-h-11 min-w-0 items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/45 dark:focus-visible:ring-brand-300/70",
                item.isActive
                  ? "bg-brand-500 text-white shadow-sm shadow-brand-500/25 dark:bg-brand-400 dark:text-slate-950"
                  : "bg-white/45 text-slate-800 hover:bg-white/75 hover:text-brand-700 dark:bg-white/10 dark:text-slate-100 dark:hover:bg-white/15 dark:hover:text-brand-300",
              ]}
            >
              <Icon name={item.icon} class="h-4 w-4 shrink-0" />
              <span class="min-w-0 truncate">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<div class="h-12"></div>

<script>
  declare global {
    interface Window {
      __blogHeaderController?: AbortController;
      __blogHeaderPageLoadBound?: boolean;
    }
  }

  const initHeader = () => {
    window.__blogHeaderController?.abort();
    const controller = new AbortController();
    window.__blogHeaderController = controller;
    const { signal } = controller;

    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileMenuButton = document.getElementById(
      "mobile-menu-btn",
    ) as HTMLButtonElement | null;
    const menuIcon = document.querySelector<HTMLElement>("[data-menu-icon]");
    const closeIcon = document.querySelector<HTMLElement>("[data-close-icon]");

    if (!mobileMenu || !mobileMenuButton) return;
    let lastFocusWithinMenu: HTMLElement | null = null;

    const getMenuFocusables = () =>
      Array.from(
        mobileMenu.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => !element.hasAttribute("disabled"));

    const setMobileMenuOpen = (isOpen: boolean, returnFocus = false) => {
      mobileMenu.classList.toggle("hidden", !isOpen);
      mobileMenuButton.setAttribute("aria-expanded", String(isOpen));
      menuIcon?.classList.toggle("hidden", isOpen);
      closeIcon?.classList.toggle("hidden", !isOpen);

      if (isOpen) {
        window.setTimeout(() => {
          const focusables = getMenuFocusables();
          const target = lastFocusWithinMenu ?? focusables[0] ?? mobileMenu;
          target.focus();
        }, 0);
      } else if (returnFocus) {
        mobileMenuButton.focus();
      }
    };

    setMobileMenuOpen(false);

    mobileMenuButton.addEventListener(
      "click",
      () => {
        const isOpen = mobileMenu.classList.contains("hidden");
        if (isOpen) {
          lastFocusWithinMenu = null;
        }
        setMobileMenuOpen(isOpen);
      },
      { signal },
    );

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMobileMenuOpen(false), {
        signal,
      });
    });

    mobileMenu.addEventListener(
      "focusin",
      (event) => {
        if (event.target instanceof HTMLElement) {
          lastFocusWithinMenu = event.target;
        }
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Node && !header?.contains(event.target)) {
          setMobileMenuOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (mobileMenu.classList.contains("hidden")) return;

        if (event.key === "Escape") {
          event.preventDefault();
          setMobileMenuOpen(false, true);
          return;
        }

        if (event.key === "Tab") {
          const focusables = getMenuFocusables();
          if (focusables.length === 0) {
            event.preventDefault();
            mobileMenu.focus();
            return;
          }

          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          const active = document.activeElement;

          if (!(active instanceof Node) || !mobileMenu.contains(active)) {
            event.preventDefault();
            (event.shiftKey ? last : first).focus();
          } else if (event.shiftKey && active === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && active === last) {
            event.preventDefault();
            first.focus();
          }
        }
      },
      { signal },
    );

    window.addEventListener(
      "resize",
      () => {
        if (window.matchMedia("(min-width: 1024px)").matches) {
          setMobileMenuOpen(false);
        }
      },
      { signal },
    );
  };

  initHeader();

  if (!window.__blogHeaderPageLoadBound) {
    document.addEventListener("astro:page-load", initHeader);
    window.__blogHeaderPageLoadBound = true;
  }
</script>
