---
import { Icon } from 'astro-icon/components';
import { site } from '@data/site';
import { nav } from '@data/nav';
import { getLangFromUrl, useTranslations, localizedPath } from '@i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="fixed top-0 left-0 right-0 z-40">
  <nav class="flex min-w-0 items-center gap-3 border-b border-white/30 bg-white/62 px-3 py-2.5 text-slate-950 shadow-sm shadow-slate-950/10 backdrop-blur-xl backdrop-saturate-150 dark:border-white/10 dark:bg-slate-950/45 dark:text-white sm:px-5 lg:px-8">
    <div class="flex min-w-0 flex-1 items-center justify-between gap-3 lg:justify-start lg:gap-5 lg:pl-[34vw] xl:pl-[40vw] 2xl:pl-[43vw]">
      <a
        href={localizedPath('/', lang)}
        class="min-w-0 truncate font-serif text-base font-bold whitespace-nowrap hover:opacity-80 sm:text-lg lg:shrink-0"
      >
        {site.title[lang]}
      </a>

      <ul class="hidden items-center gap-0.5 text-sm lg:flex">
        {nav.map((item) => (
          <li>
            <a
              href={localizedPath(item.href, lang)}
              class="rounded-md px-2.5 py-1.5 text-slate-800/88 transition-colors hover:bg-white/55 hover:text-slate-950 dark:text-white/84 dark:hover:bg-white/10 dark:hover:text-white"
            >
              {t('nav.' + item.key)}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- 移动端菜单 -->
    <button
      type="button"
      aria-label="Menu"
      class="shrink-0 rounded-full p-1.5 transition-colors hover:bg-white/55 dark:hover:bg-white/10 sm:p-2 lg:hidden"
      id="mobile-menu-btn"
    >
      <Icon name="mdi:menu" class="w-5 h-5" />
    </button>
  </nav>

  <!-- 移动端菜单面板 -->
  <div id="mobile-menu" class="hidden lg:hidden mx-3 mt-2 glass-strong p-4">
    <ul class="flex flex-col gap-1">
      {nav.map((item) => (
        <li>
          <a
            href={localizedPath(item.href, lang)}
            class="block px-3 py-2 rounded-md hover:bg-brand-100/50 dark:hover:bg-brand-900/40 transition-colors text-sm"
          >
            {t('nav.' + item.key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<!-- 占位高度避免内容被覆盖 -->
<div class="h-12"></div>

<script>
  declare global {
    interface Window {
      __blogHeaderController?: AbortController;
      __blogHeaderPageLoadBound?: boolean;
    }
  }

  const initHeader = () => {
    window.__blogHeaderController?.abort();
    const controller = new AbortController();
    window.__blogHeaderController = controller;
    const { signal } = controller;

    // 移动菜单
    const mobileMenu = document.getElementById('mobile-menu');
    document.getElementById('mobile-menu-btn')?.addEventListener(
      'click',
      () => {
        mobileMenu?.classList.toggle('hidden');
      },
      { signal }
    );
  };

  initHeader();

  if (!window.__blogHeaderPageLoadBound) {
    document.addEventListener('astro:page-load', initHeader);
    window.__blogHeaderPageLoadBound = true;
  }
</script>
