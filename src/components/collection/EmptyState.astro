---
export interface Props {
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, description, actionHref, actionLabel } = Astro.props;
---

<div
  class="glass-soft border border-dashed border-brand-300/40 px-6 py-10 text-center md:px-10"
>
  <p
    class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-300"
  >
    Empty Collection
  </p>
  <h2 class="mb-3 font-serif text-2xl font-semibold text-ink">{title}</h2>
  <p class="mx-auto max-w-xl text-sm leading-relaxed text-muted">
    {description}
  </p>
  {
    actionHref && actionLabel && (
      <a
        href={actionHref}
        class="glass-pill glass-hover mt-6 inline-flex px-5 py-2 text-sm font-semibold"
      >
        {actionLabel}
      </a>
    )
  }
</div>
