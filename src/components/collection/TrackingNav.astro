---
export interface Props {
  current: "anime" | "games" | "books" | "movies";
}

import { getLangFromUrl, localizedPath } from "@i18n/ui";

const { current } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const items = [
  { key: "anime", label: "番剧", href: "/tracking/anime/" },
  { key: "games", label: "游戏", href: "/tracking/games/" },
  { key: "books", label: "读书", href: "/tracking/books/" },
  { key: "movies", label: "电影", href: "/tracking/movies/" },
] as const;
---

<nav class="mb-8 flex flex-wrap gap-2" aria-label="内容追踪分类">
  {
    items.map((item) => (
      <a
        href={localizedPath(item.href, lang)}
        aria-current={item.key === current ? "page" : undefined}
        class:list={[
          "rounded-full border px-4 py-2 text-sm font-semibold transition-colors",
          item.key === current
            ? "border-brand-500 bg-brand-500 text-white shadow-sm shadow-brand-500/25"
            : "border-brand-200/60 bg-white/35 text-ink hover:border-brand-400 hover:bg-brand-100/50 dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10",
        ]}
      >
        {item.label}
      </a>
    ))
  }
</nav>
