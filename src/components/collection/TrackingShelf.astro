---
import EmptyState from "./EmptyState.astro";

export interface TrackingLink {
  label: string;
  href: string;
}

export interface TrackingItem {
  title: string;
  subtitle?: string;
  status: string;
  statusLabel: string;
  rating?: number;
  cover?: string;
  meta?: string[];
  tags?: string[];
  links?: TrackingLink[];
}

export interface TrackingFilter {
  value: string;
  label: string;
  count: number;
}

export interface Props {
  items: TrackingItem[];
  filters: TrackingFilter[];
  emptyTitle: string;
  emptyDescription: string;
}

const { items, filters, emptyTitle, emptyDescription } = Astro.props;
const fallbackCover = "/images/placeholders/og-default.placeholder.svg";

function formatRating(rating: number | undefined): string {
  if (typeof rating !== "number") return "未评分";
  return Number.isInteger(rating) ? `${rating}/10` : `${rating.toFixed(1)}/10`;
}

function ratingWidth(rating: number | undefined): string {
  if (typeof rating !== "number") return "0%";
  return `${Math.max(0, Math.min(100, rating * 10))}%`;
}
---

{
  items.length === 0 ? (
    <EmptyState title={emptyTitle} description={emptyDescription} />
  ) : (
    <section data-tracking-shelf>
      <div class="mb-6 flex flex-wrap gap-2" role="list" aria-label="状态筛选">
        <button
          type="button"
          data-tracking-filter="all"
          aria-pressed="true"
          class="tracking-filter rounded-full border border-brand-200/70 px-3 py-1.5 text-sm font-semibold transition-colors"
        >
          全部 <span class="text-xs opacity-75">({items.length})</span>
        </button>
        {filters.map((filter) => (
          <button
            type="button"
            data-tracking-filter={filter.value}
            aria-pressed="false"
            class="tracking-filter rounded-full border border-brand-200/70 px-3 py-1.5 text-sm font-semibold transition-colors"
          >
            {filter.label}{" "}
            <span class="text-xs opacity-75">({filter.count})</span>
          </button>
        ))}
      </div>

      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {items.map((item) => (
          <article
            data-tracking-card
            data-status={item.status}
            class="glass glass-hover overflow-hidden"
          >
            <div class="aspect-[4/3] bg-brand-100/30 dark:bg-white/5">
              <img
                src={item.cover ?? fallbackCover}
                alt={item.title}
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="p-5">
              <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-brand-500/15 px-2.5 py-1 font-semibold text-brand-700 dark:text-brand-300">
                  {item.statusLabel}
                </span>
                {item.meta?.map((meta) => (
                  <span class="text-muted">{meta}</span>
                ))}
              </div>

              <h2 class="font-serif text-xl font-semibold leading-snug text-ink">
                {item.title}
              </h2>
              {item.subtitle && (
                <p class="mt-1 text-sm text-muted">{item.subtitle}</p>
              )}

              <div class="mt-4">
                <div class="mb-1 flex items-center justify-between text-xs text-muted">
                  <span>评分</span>
                  <span class="font-mono">{formatRating(item.rating)}</span>
                </div>
                <div class="h-1.5 overflow-hidden rounded-full bg-brand-100/70 dark:bg-white/10">
                  <span
                    class="block h-full rounded-full bg-brand-500"
                    style={`width: ${ratingWidth(item.rating)}`}
                  />
                </div>
              </div>

              {item.tags && item.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {item.tags.slice(0, 5).map((tag) => (
                    <span class="rounded-full bg-brand-100/50 px-2 py-0.5 text-xs text-brand-700 dark:bg-brand-900/30 dark:text-brand-200">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}

              {item.links && item.links.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-2">
                  {item.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                      class="rounded-full border border-brand-200/70 px-3 py-1 text-xs font-semibold hover:border-brand-500 hover:bg-brand-100/50 dark:border-white/10 dark:hover:bg-white/10"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .tracking-filter {
    background: rgb(var(--glass-bg) / 0.35);
    color: rgb(var(--color-ink));
  }

  .tracking-filter[aria-pressed="true"] {
    border-color: transparent;
    background: rgb(var(--color-brand-500) / 1);
    color: white;
  }
</style>

<script>
  declare global {
    interface Window {
      __trackingShelfBound?: boolean;
    }
  }

  const initTrackingShelves = () => {
    document
      .querySelectorAll<HTMLElement>("[data-tracking-shelf]")
      .forEach((shelf) => {
        if (shelf.dataset.ready === "true") return;
        shelf.dataset.ready = "true";

        const buttons = Array.from(
          shelf.querySelectorAll<HTMLButtonElement>("[data-tracking-filter]"),
        );
        const cards = Array.from(
          shelf.querySelectorAll<HTMLElement>("[data-tracking-card]"),
        );

        const applyFilter = (value: string) => {
          buttons.forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.trackingFilter === value),
            );
          });
          cards.forEach((card) => {
            const isVisible = value === "all" || card.dataset.status === value;
            card.hidden = !isVisible;
          });
        };

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            applyFilter(button.dataset.trackingFilter ?? "all");
          });
        });
      });
  };

  initTrackingShelves();

  if (!window.__trackingShelfBound) {
    document.addEventListener("astro:page-load", initTrackingShelves);
    window.__trackingShelfBound = true;
  }
</script>
