{
  "name": "my-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "个人博客 — Astro + GitHub Pages, glassmorphism style, bilingual",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "new": "node scripts/new-post.mjs",
    "new:moment": "node scripts/new-moment.mjs",
    "new:gallery": "node scripts/new-gallery.mjs",
    "compress": "node scripts/compress-images.mjs",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "check:images": "node scripts/check-images.mjs",
    "lint": "eslint . --ext .js,.ts,.astro && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.3",
    "@astrojs/react": "^4.1.2",
    "@astrojs/rss": "^4.0.10",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "@iconify-json/mdi": "^1.2.1",
    "@iconify-json/simple-icons": "^1.2.16",
    "astro": "^5.0.5",
    "astro-expressive-code": "^0.40.1",
    "astro-icon": "^1.1.5",
    "astro-pagefind": "^1.7.0",
    "mermaid": "^11.15.0",
    "pagefind": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.16",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "cspell": "^8.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "fontmin": "^0.9.9",
    "gray-matter": "^4.0.3",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
